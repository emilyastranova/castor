# Copy to .env and change every secret before exposing Castor to a network.

# Session signing key for the API (any long random string)
CASTOR_SECRET_KEY=change-me-to-a-long-random-string
# Shared secret agents present when they connect
CASTOR_AGENT_SECRET=change-me-agent-secret

# First admin user (created on first start only)
CASTOR_ADMIN_USERNAME=admin
CASTOR_ADMIN_PASSWORD=castor

# Postgres password used by the compose stack
CASTOR_DB_PASSWORD=castor

# Port the UI is served on
CASTOR_HTTP_PORT=8080

# Optional in-stack agent (enable with: docker compose --profile agent up)
CASTOR_AGENT_NAME=compose-agent
CASTOR_AGENT_TAGS=lab
# Host container socket mounted into the in-stack agent
# podman: /run/user/1000/podman/podman.sock   docker: /var/run/docker.sock
CONTAINER_SOCKET=/var/run/docker.sock
