# Copy to .env and change every secret before exposing Castor to a network.

# Session signing key for the API (any long random string)
CASTOR_SECRET_KEY=change-me-to-a-long-random-string
# Shared secret agents can connect with. Better: give each agent its own token (Agents →
# Enroll agent), then turn the shared secret off.
CASTOR_AGENT_SECRET=change-me-agent-secret
# CASTOR_ALLOW_SHARED_AGENT_SECRET=false
# Encrypts variable-set secrets and files at rest (Fernet key). Leave unset to have one
# generated into the data directory on first start; either way, back it up with the
# database or the stored secrets become unreadable. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CASTOR_VAULT_KEY=

# Notifications (a playbook step waiting for a decision, a run finishing) are also posted
# to these webhooks, comma separated: Slack or Discord incoming-webhook URLs, an ntfy topic
# (https://ntfy.sh/<topic>), or any URL that accepts JSON.
# CASTOR_NOTIFY_WEBHOOKS=
# Where people reach the UI, so links in webhook messages work
# CASTOR_PUBLIC_URL=http://localhost:8080

# Plugins. Restricted mode (on unless an admin turns it off in Settings → Plugins) keeps out
# unrestricted plugins, which get full access to the server; true here keeps it on for good.
# CASTOR_PLUGINS_RESTRICTED=true
# Safe mode starts Castor with every plugin stopped, to recover from a bad one.
# CASTOR_PLUGINS_SAFE_MODE=true

# First admin user (created on first start only)
CASTOR_ADMIN_USERNAME=admin
CASTOR_ADMIN_PASSWORD=castor

# Postgres password used by the compose stack
CASTOR_DB_PASSWORD=castor

# Port the UI is served on
CASTOR_HTTP_PORT=8080

# Optional in-stack agent (enable with: docker compose --profile agent up)
CASTOR_AGENT_NAME=compose-agent
# The in-stack agent's own token, from Agents → Enroll agent (used instead of the secret)
# CASTOR_AGENT_TOKEN=
CASTOR_AGENT_TAGS=lab
# Host container socket mounted into the in-stack agent
# podman: /run/user/1000/podman/podman.sock   docker: /var/run/docker.sock
CONTAINER_SOCKET=/var/run/docker.sock
